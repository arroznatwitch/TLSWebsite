                "−2 500 a +2 500"
              ],
              [
                "6.ª",
                "3 750",
                "−1 875 a +1 875"
              ],
              [
                "7.ª",
                "2 500",
                "−1 250 a +1 250"
              ],
              [
                "8.ª",
                "1 000",
                "−500 a +500"
              ],
              [
                "9.ª",
                "500",
                "−250 a +250"
              ],
              [
                "10.ª",
                "50",
                "−25 a +25"
              ]
            ]
          },
          "Atenção: a partir da 2.ª borda a vida deixa de regenerar automaticamente, por isso convém ter cuidado que perder vida desnecessária pode ser fatal."
        ]
